<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>sqoop_concurrent_imports</name>
  <description>Runs overlapping Sqoop imports after the first has initialized and created its output directory.</description>
  <directory>/</directory>
  <parameters/>
  <slaveservers/>
  <entries>
    <entry>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>Y</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>128</xloc>
      <yloc>256</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Sqoop import one row</name>
      <description/>
      <type>SqoopImport</type>
      <attributes/>
      <targetDir>/it/sqoop/concurrent-one</targetDir>
      <database>postgres docker</database>
      <schema>public</schema>
      <connect>jdbc:postgresql://postgres-hostname:5432/postgres</connect>
      <username>myuser</username>
      <password>Encrypted 2d3e1dcad09d59790bb18bd63c99dbdde</password>
      <table>hadoop</table>
      <where>hadoop_column = 1 AND (SELECT 1 FROM pg_sleep(20)) = 1</where>
      <numMappers>1</numMappers>
      <clusterName/>
      <customArguments class="org.pentaho.big.data.kettle.plugins.job.PropertyEntry">
        <PropertyEntry><key>pentahoNamedCluster</key><value>it-cluster</value></PropertyEntry>
        <PropertyEntry><key>mapreduce.framework.name</key><value>yarn</value></PropertyEntry>
        <PropertyEntry><key>mapreduce.app-submission.cross-platform</key><value>true</value></PropertyEntry>
      </customArguments>
      <deleteTargetDir>true</deleteTargetDir>
      <jobEntryName>Sqoop import one row</jobEntryName>
      <blockingPollingInterval>300</blockingPollingInterval>
      <blockingExecution>true</blockingExecution>
      <namenodeHost>hadoop-hostname</namenodeHost>
      <namenodePort>9000</namenodePort>
      <shimIdentifier/>
      <jobtrackerHost/>
      <jobtrackerPort/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>496</xloc>
      <yloc>176</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Wait for first import output</name>
      <description/>
      <type>WAIT_FOR_FILE</type>
      <attributes/>
      <filename>hc://it-cluster/it/sqoop/concurrent-one</filename>
      <maximum_timeout>120</maximum_timeout>
      <check_cycle_time>1</check_cycle_time>
      <success_on_timeout>N</success_on_timeout>
      <file_size_check>N</file_size_check>
      <add_filename_result>N</add_filename_result>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>320</xloc>
      <yloc>336</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Sqoop import two rows</name>
      <description/>
      <type>SqoopImport</type>
      <attributes/>
      <targetDir>/it/sqoop/concurrent-two</targetDir>
      <database>postgres docker</database>
      <schema>public</schema>
      <connect>jdbc:postgresql://postgres-hostname:5432/postgres</connect>
      <username>myuser</username>
      <password>Encrypted 2d3e1dcad09d59790bb18bd63c99dbdde</password>
      <table>hadoop</table>
      <numMappers>1</numMappers>
      <clusterName/>
      <customArguments class="org.pentaho.big.data.kettle.plugins.job.PropertyEntry">
        <PropertyEntry><key>pentahoNamedCluster</key><value>it-cluster</value></PropertyEntry>
        <PropertyEntry><key>mapreduce.framework.name</key><value>yarn</value></PropertyEntry>
        <PropertyEntry><key>mapreduce.app-submission.cross-platform</key><value>true</value></PropertyEntry>
      </customArguments>
      <deleteTargetDir>true</deleteTargetDir>
      <jobEntryName>Sqoop import two rows</jobEntryName>
      <blockingPollingInterval>300</blockingPollingInterval>
      <blockingExecution>true</blockingExecution>
      <namenodeHost>hadoop-hostname</namenodeHost>
      <namenodePort>9000</namenodePort>
      <shimIdentifier/>
      <jobtrackerHost/>
      <jobtrackerPort/>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>496</xloc>
      <yloc>336</yloc>
      <attributes_kjc/>
    </entry>
  </entries>
  <hops>
    <hop><from>Start</from><to>Sqoop import one row</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>Start</from><to>Wait for first import output</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>Y</unconditional></hop>
    <hop><from>Wait for first import output</from><to>Sqoop import two rows</to><from_nr>0</from_nr><to_nr>0</to_nr><enabled>Y</enabled><evaluation>Y</evaluation><unconditional>N</unconditional></hop>
  </hops>
  <notepads/>
  <attributes/>
</job>